# Database configuration
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/rag_db

# LM Studio Configuration
LM_STUDIO_API_BASE=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-4-e4b

# Observability Configurations (Arize Phoenix & Langfuse)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
LANGFUSE_PUBLIC_KEY=pk-lf-default
LANGFUSE_SECRET_KEY=sk-lf-default
LANGFUSE_HOST=https://cloud.langfuse.com

# Cloud LLM Configuration (Optional: set GEMINI_API_KEY to offload synthesis/evals to cloud free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

